{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoverThought",
  "version": "0.1.9",
  "identifier": "com.hoverthought.hud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "a920a0e7-bebf-5189-bf5f-b75077bb8aeb"
      }
    },
    "linux": {
      "deb": {
        "conflicts": [
          "hover-thought-hud"
        ],
        "replaces": [
          "hover-thought-hud"
        ]
      },
      "rpm": {
        "conflicts": [
          "hover-thought-hud"
        ],
        "obsoletes": [
          "hover-thought-hud"
        ]
      }
    }
  }
}
